rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read published content (news, panel, alumni, activities,
    // resources, gallery). Only signed-in executives (Firebase Auth users
    // created for the panel) can create, edit, or delete.
    match /{collection}/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
